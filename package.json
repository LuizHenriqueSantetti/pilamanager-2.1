{
  "name": "pilamanager-demo-postgresql",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Demonstração acadêmica independente: autenticação e pacientes com PostgreSQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:integracao": "node --test --test-concurrency=1 tests/integracao/*.test.js",
    "test:navegadores": "node --test --test-concurrency=1 --test-timeout=180000 tests/navegadores/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
