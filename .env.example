# Modelo. O INICIAR.bat gera o .env real com senhas aleatorias.
# Nunca compartilhe o .env nem senhas reais.
PORT=3000
DB_HOST=127.0.0.1
# 5434 = porta do PostgreSQL da demo (separado de outros bancos do computador).
DB_PORT=5434
DB_NAME=pilamanager_demo
DB_USER=pilamanager_demo
POSTGRES_PASSWORD=troque-esta-senha-do-banco
DB_PASSWORD=troque-esta-senha-do-banco
# Somente modo local: pasta da instancia e senha do superusuario dela (gerada automaticamente).
PG_DATA_DIR=C:\Users\SEU_USUARIO\AppData\Local\PilaManagerDemo\postgres-data
PG_SUPERUSER_PASSWORD=troque-esta-senha
DEMO_ADMIN_EMAIL=gerencia@pilamanager.local
DEMO_ADMIN_NAME=Luiz Henrique
DEMO_ADMIN_PASSWORD=defina-uma-senha-forte-aqui
COOKIE_SECURE=false
NODE_ENV=development
